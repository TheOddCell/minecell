  trap 'kill "$proxypid" 2>/dev/null' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  up=false
  for _ in $(seq 1 60); do
    kill -0 "$proxypid" 2>/dev/null || break
    if (exec 9<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then up=true; break; fi
    sleep 0.5
  done
  if ! $up; then
    echo "minecell: viaproxy did not start, last lines of $proxylog:" >&2
    tail -n 15 "$proxylog" >&2
    exit 1
  fi
  # not exec: the proxy has to be stopped when the game exits
  ( cd "$gamedir" && "${cmd[@]}" )
  exit $?
fi
cd "$gamedir" && exec "${cmd[@]}"
