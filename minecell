#!/bin/bash
VERSION="3.3.0"
tmpdir="$(mktemp -d)"
cachedir="$HOME/.odd/minecell"
snapshot="false"
name="${USER:-$(id -un)}"
name="${name//[^A-Za-z0-9_]/_}"
name="${name:0:16}"
[ -n "$name" ] || name=doofus
fakecache="false"
if ! [ -d "$cachedir" ]; then cachedir="$tmpdir/fakecache";mkdir "$cachedir"; fakecache="true"; fi
gamedir="$cachedir/instance"
worlds="$cachedir/worlds"
mem=""
java="java"
server=""
want=""
notype="false"
skinof=""
fabric="false"
online="false"
fakeonline="false"
nodl="false"
msclient=""
mcname=""; mcuuid=""; mctoken=""; usertype="legacy"
dryrun="false"
list="false"
version=""
passthrough="false"
extra=()
# dependencies: every external command the script uses, with the package it usually comes from
missingdeps=()
for dep in curl:curl jq:jq sed:sed grep:grep sha1sum:coreutils md5sum:coreutils mktemp:coreutils \
           cut:coreutils sha256sum:coreutils date:coreutils chmod:coreutils sort:coreutils wc:coreutils ln:coreutils mv:coreutils mkdir:coreutils \
           dirname:coreutils xargs:findutils find:findutils; do
  command -v "${dep%%:*}" > /dev/null || missingdeps+=("${dep%%:*} (${dep##*:})")
done
if [ "${#missingdeps[@]}" -gt 0 ]; then
  echo "minecell: missing required programs: ${missingdeps[*]}" >&2
  exit 1
fi
# config file: sets the defaults, command line options override it. it is (re)written with every
# line commented out when it is missing or has nothing but comments in it
conf="${MINECELL_CONFIG:-$HOME/.odd/minecell.conf}"
write_conf() {
  mkdir -p "$(dirname "$conf")"
  cat > "$conf" <<EOF
# minecell config: uncomment a line to change that default (command line options still win).
# if every line is commented out (or this file is deleted) minecell writes this template again.

# dir="\$HOME/.odd/minecell/instance"
# name="$name"
# mem=""
# java="java"
# server=""
# snapshot="false"
# version=""
# skin_of=""
# fabric="false"
# online_mode="false"
# fake_online_mode="false"
# ms_client_id=""
# no_download="false"
EOF
}
load_conf() {
  local dir="" name="" mem="" java="" server="" snapshot="" version="" skin_of="" fabric="" online_mode="" fake_online_mode="" ms_client_id="" no_download=""
  . "$conf"
  cfg_dir="$dir"; cfg_name="$name"; cfg_mem="$mem"; cfg_java="$java"
  cfg_server="$server"; cfg_snapshot="$snapshot"; cfg_version="$version"; cfg_skin_of="$skin_of"; cfg_fabric="$fabric"; cfg_online_mode="$online_mode"; cfg_fake_online_mode="$fake_online_mode"; cfg_ms_client_id="$ms_client_id"; cfg_no_download="$no_download"
}
if ! grep -qv -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$conf" 2>/dev/null; then
  write_conf
else
  load_conf
  if [ -n "$cfg_dir" ]; then gamedir="$cfg_dir"; fi
  if [ -n "$cfg_name" ]; then
    name="${cfg_name//[^A-Za-z0-9_]/_}"; name="${name:0:16}"
    [ -n "$name" ] || name=doofus
  fi
  if [ -n "$cfg_mem" ]; then mem="$cfg_mem"; fi
  if [ -n "$cfg_java" ]; then java="$cfg_java"; fi
  if [ -n "$cfg_server" ]; then server="$cfg_server"; fi
  if [ "$cfg_snapshot" = "true" ]; then snapshot="true"; fi
  if [ -n "$cfg_version" ]; then want="$cfg_version"; fi
  if [ -n "$cfg_skin_of" ]; then skinof="$cfg_skin_of"; fi
  if [ "$cfg_fabric" = "true" ]; then fabric="true"; fi
  if [ "$cfg_online_mode" = "true" ]; then online="true"; fi
  if [ "$cfg_fake_online_mode" = "true" ]; then fakeonline="true"; fi
  if [ -n "$cfg_ms_client_id" ]; then msclient="$cfg_ms_client_id"; fi
  if [ "$cfg_no_download" = "true" ]; then nodl="true"; fi
fi
defdir="$gamedir"
defname="$name"
usage() {
  echo "minecell $VERSION reporting for duty"
  cat <<EOF
usage: minecell [options] [-- game args]
launches the latest release (or the latest snapshot with -s), or the version given with -v

  -s, --snapshot     launch the latest snapshot instead of the latest release
                     (with -l: include snapshots in the list)
  -v, --version VER  launch this version instead of the latest (see -l)
  -d, --dir PATH     game directory (default: $defdir)
  -n, --name NAME    player name (default: $defname)
  -m, --mem SIZE     max heap, e.g. 4G
  -j, --java PATH    java binary (default: java)
  -S, --server HOST  join a server straight away
  -o, --online-mode  log in with a microsoft account (device code login, token kept in the cache dir)
      --fake-online-mode  join -S through viaproxy (needs the viaproxy folder in the cache dir, see --proxy-login)
  -l, --list         list available versions, one per line (releases; add -s for snapshots too, shown as "version type")
  -f, --fabric       run the chosen version with the latest stable fabric loader (downloaded once)
  -k, --skin-of NAME use the skin of this real minecraft account (looks up its uuid)
  -N, --no-download  download nothing and use only the versions already downloaded (also switched on by itself
                     when mojang can't be reached): the newest x.y or x.y.z is the release, snapshots need -v
  -T, --no-type      with -l -s: print only the version, not its type
      --dry-run      print the java command instead of running it
  -h, --help         show this help (short options can be combined: -Nsl, -Nv 26.3 -n odd)
      --             pass everything after it to the game
EOF
}
# clustered short options (-Nsl, -Nv 26.3, -nodd) are split up the way getopt does it: a letter that takes
# a value (d n m j S v k) uses the rest of the cluster if there is one, otherwise the next argument
eargs=(); need=false; past=false
for a in "$@"; do
  if $past || $need; then eargs+=("$a"); need=false; continue; fi
  if [ "$a" = "--" ]; then past=true; eargs+=("$a"); continue; fi
  if [[ "$a" == -[!-]* ]] && [ "${#a}" -gt 2 ]; then
    rest="${a:1}"
    while [ -n "$rest" ]; do
      c="${rest:0:1}"; rest="${rest:1}"
      eargs+=("-$c")
      case "$c" in
        d|n|m|j|S|v|k)
          if [ -n "$rest" ]; then eargs+=("$rest"); rest=""; else need=true; fi ;;
      esac
    done
  else
    eargs+=("$a")
  fi
done
for i in "${eargs[@]}"; do
  if [ "$passthrough" = "true" ]; then
    extra+=("$i")
    continue
  fi
  if [ "$gamedir" = "hahayoubrokesomething" ]; then
    gamedir="$i"
    continue
  fi
  if [ "$name" = "hahayoubrokesomething" ]; then
    name="$i"
    name="${name//[^A-Za-z0-9_]/_}"
    name="${name:0:16}"
    [ -n "$name" ] || name=doofus
    continue
  fi
  if [ "$mem" = "hahayoubrokesomething" ]; then
    mem="$i"
    continue
  fi
  if [ "$java" = "hahayoubrokesomething" ]; then
    java="$i"
    continue
  fi
  if [ "$server" = "hahayoubrokesomething" ]; then
    server="$i"
    continue
  fi
  if [ "$want" = "hahayoubrokesomething" ]; then
    want="$i"
    continue
  fi
  if [ "$skinof" = "hahayoubrokesomething" ]; then
    skinof="$i"
    continue
  fi
  if [ "$i" = "--snapshot" ] || [ "$i" = "-s" ]; then
    snapshot="true"
    continue
  elif [ "$i" = "--dir" ] || [ "$i" = "-d" ]; then
    gamedir="hahayoubrokesomething"
    continue
  elif [ "$i" = "--name" ] || [ "$i" = "-n" ]; then
    name="hahayoubrokesomething"
    continue
  elif [ "$i" = "--mem" ] || [ "$i" = "-m" ]; then
    mem="hahayoubrokesomething"
    continue
  elif [ "$i" = "--java" ] || [ "$i" = "-j" ]; then
    java="hahayoubrokesomething"
    continue
  elif [ "$i" = "--server" ] || [ "$i" = "-S" ]; then
    server="hahayoubrokesomething"
    continue
  elif [ "$i" = "--version" ] || [ "$i" = "-v" ]; then
    want="hahayoubrokesomething"
    continue
  elif [ "$i" = "--online-mode" ] || [ "$i" = "-o" ]; then
    online="true"
    continue
  elif [ "$i" = "--fake-online-mode" ]; then
    fakeonline="true"
    continue
  elif [ "$i" = "--fabric" ] || [ "$i" = "-f" ]; then
    fabric="true"
    continue
  elif [ "$i" = "--skin-of" ] || [ "$i" = "-k" ]; then
    skinof="hahayoubrokesomething"
    continue
  elif [ "$i" = "--no-download" ] || [ "$i" = "-N" ]; then
    nodl="true"
    continue
  elif [ "$i" = "--no-type" ] || [ "$i" = "-T" ]; then
    notype="true"
    continue
  elif [ "$i" = "--dry-run" ]; then
    dryrun="true"
    continue
  elif [ "$i" = "--list" ] || [ "$i" = "-l" ]; then
    list="true"
    continue
  elif [ "$i" = "--help" ] || [ "$i" = "-h" ]; then
    usage
    exit 0
  elif [ "$i" = "--proxy-login" ]; then
    if ! command -v "$java" > /dev/null; then
      echo "minecell: java not found ($java): install a jdk or point -j at one" >&2
    fi
    echo "minecell: downloading viaproxy"
    version="$(curl -fsSL https://api.github.com/repos/ViaVersion/ViaProxy/releases/latest | jq -r '.tag_name')"
    version="${version:1}"
    echo "minecell: latest version is $version, downloading..."
    mkdir -p "$cachedir/viaproxy"
    curl -fsSL "https://github.com/ViaVersion/ViaProxy/releases/download/v$version/ViaProxy-$version.jar" -o "$cachedir/viaproxy/via.jar"
    cd "$cachedir/viaproxy"
    echo "minecell: please add your user and close."
    exec java -jar *.jar
  elif [ "$i" = "--" ]; then
    passthrough="true"
    continue
  elif [ "${i:0:1}" = "-" ]; then
    echo "minecell: unknown option: $i" >&2
    exit 1
  fi
  echo "minecell: unexpected argument: $i (use -v to pick a version)" >&2
  exit 1
done
for v in "$gamedir" "$name" "$mem" "$java" "$server" "$want" "$skinof"; do
  if [ "$v" = "hahayoubrokesomething" ]; then
    echo "minecell: option is missing its value" >&2
    exit 1
  fi
done
if $online && $fakeonline; then
  echo "minecell: pick one of -o/--online-mode and --fake-online-mode" >&2
  exit 1
fi
# --fake-online-mode runs viaproxy from <cache>/viaproxy and joins -S through it
viaproxydir="$cachedir/viaproxy"
if $fakeonline && ! $list; then
  if [ -z "$server" ]; then
    echo "minecell: --fake-online-mode needs -S (the server to join through viaproxy)" >&2
    exit 1
  fi
  if ! [[ "$server" =~ ^[A-Za-z0-9._:-]+$ ]]; then
    echo "minecell: $server is not a valid server address" >&2
    exit 1
  fi
  if ! [ -f "$viaproxydir/via.jar" ] || ! [ -f "$viaproxydir/viaproxy.yml" ]; then
    echo "minecell: --fake-online-mode needs a viaproxy folder with via.jar and viaproxy.yml in $cachedir (run minecell --proxy-login once)" >&2
    exit 1
  fi
fi
# an explicitly chosen java (-j or the config) has to exist; with the default one, minecell settles it later:
# system java if it is recent enough, else a downloaded one
if ! $list && ! $dryrun && [ "$java" != "java" ] && ! command -v "$java" > /dev/null; then
  echo "minecell: java not found ($java): install a jdk or point -j at one" >&2
  exit 1
fi
# fd 3 is the real stdout: in --dry-run everything but the raw command (and -l's list) goes to stderr
exec 3>&1
if $dryrun; then exec 1>&2; fi
if $fakecache; then
  echo "minecell: warning: ~/.odd/minecell doesn't exist, so this run uses a throwaway cache in $cachedir" >&2
  echo "minecell: nothing is kept (downloads, worlds, instance). run: mkdir ~/.odd/minecell" >&2
fi
manifest="$cachedir/manifest.json"
url="https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"
# versions that are already downloaded (a json plus a jar, its own or its parent's), newest first
localversions() {
  local d id parent
  for d in "$cachedir/versions"/*/; do
    [ -d "$d" ] || continue
    id="${d%/}"; id="${id##*/}"
    [ -f "$d$id.json" ] || continue
    if ! [ -f "$d$id.jar" ]; then
      parent="$(jq -r '.inheritsFrom // empty' "$d$id.json" 2>/dev/null)"
      [ -n "$parent" ] && [ -f "$cachedir/versions/$parent/$parent.jar" ] || continue
    fi
    echo "$id"
  done | sort -rV
}
# in no-download mode x.y and x.y.z names are releases, names with fabric/forge/quilt/modded in them are
# modded, and everything else counts as a snapshot
isrelease() { [[ "$1" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; }
vtype() {
  case "${1,,}" in
    *fabric*|*forge*|*quilt*|*modded*) vt=modded ;;
    *) if isrelease "$1"; then vt=release; else vt=snapshot; fi ;;
  esac
}
if $nodl; then
  echo "minecell: no-download mode: nothing will be downloaded, only what is already in $cachedir is used" >&2
else
  had=false; [ -f "$manifest" ] && had=true
  zflag=(); $had && zflag=(-z "$manifest")
  if code=$(curl --connect-timeout 5 --max-time 60 -sL -R "${zflag[@]}" -o "$manifest.new" -w '%{http_code}' "$url"); then
    case "$code" in
      200) mv "$manifest.new" "$manifest" ;;
      304) rm -f "$manifest.new" ;;
      *)   rm -f "$manifest.new"; echo "minecell: unexpected http $code" >&2; exit 1 ;;
    esac
  else
    rm -f "$manifest.new"
    nodl="true"
    echo "minecell: could not reach mojang, switching to no-download mode: nothing will be downloaded" >&2
  fi
fi
if $list; then
  if $nodl; then
    localversions | while read -r id; do
      vtype "$id"
      if ! $snapshot && [ "$vt" != release ]; then continue; fi
      if $snapshot && ! $notype; then echo "$id $vt"; else echo "$id"; fi
    done >&3
  elif ! $snapshot; then
    jq -r '.versions[] | select(.type == "release") | .id' "$manifest" >&3
  elif $notype; then
    jq -r '.versions[].id' "$manifest" >&3
  else
    jq -r '.versions[] | "\(.id) \(.type)"' "$manifest" >&3
  fi
  exit 0
fi
if $nodl; then
  if [ -n "$want" ]; then
    version="$want"
    case "$version" in */*) echo "minecell: bad version: $version" >&2; exit 1 ;; esac
    [ -f "$cachedir/versions/$version/$version.json" ] \
      || { echo "minecell: $version is not downloaded and no-download mode is on (see -l)" >&2; exit 1; }
  elif $snapshot; then
    echo "minecell: no-download mode can't tell which snapshot is the latest: pick one with -v (see -l -s)" >&2
    exit 1
  else
    version=""
    while read -r id; do
      if isrelease "$id"; then version="$id"; break; fi
    done < <(localversions)
    [ -n "$version" ] || { echo "minecell: no downloaded release found in $cachedir/versions" >&2; exit 1; }
  fi
elif [ -n "$want" ]; then
  version="$want"
  case "$version" in */*) echo "minecell: bad version: $version" >&2; exit 1 ;; esac
  # a version json that is already in versions/ is accepted even if the manifest doesn't know it
  if ! [ -f "$cachedir/versions/$version/$version.json" ]; then
    jq -e --arg v "$version" '.versions[] | select(.id == $v)' "$manifest" > /dev/null \
      || { echo "minecell: no such version: $version (try -l, or -l -s for snapshots)" >&2; exit 1; }
  fi
elif "$snapshot"; then
  version="$(jq .latest.snapshot -r "$manifest")"
else
  version="$(jq .latest.release -r "$manifest")"
fi
if $fabric; then
  # latest stable fabric loader for this game version (newest overall if none is stable)
  mcver="$version"
  fv=""
  if ! $nodl; then
    fv="$(curl -fsSL "https://meta.fabricmc.net/v2/versions/loader/$mcver" \
          | jq -er '([.[] | select(.loader.stable)] + .)[0].loader.version')" || fv=""
  fi
  if [ -n "$fv" ]; then
    fid="fabric-loader-$fv-$mcver"
    fjson="$cachedir/versions/$fid/$fid.json"
    if ! [ -f "$fjson" ]; then
      mkdir -p "$(dirname "$fjson")"
      curl -fsSL -o "$fjson.new" "https://meta.fabricmc.net/v2/versions/loader/$mcver/$fv/profile/json" \
        && jq -e .id "$fjson.new" > /dev/null \
        || { rm -f "$fjson.new"; echo "minecell: could not download the fabric profile for $mcver" >&2; exit 1; }
      mv "$fjson.new" "$fjson"
    fi
  else
    # offline, or fabric doesn't support this version: fall back to the newest one we already have
    fid="$(ls -1v "$cachedir/versions" 2>/dev/null | grep -E "^fabric-loader-.+-${mcver//./\.}\$" | tail -1)"
    [ -n "$fid" ] || { echo "minecell: no fabric loader found for $mcver" >&2; exit 1; }
    if $nodl; then
      echo "minecell: no-download mode: using the newest downloaded fabric loader, $fid" >&2
    else
      echo "minecell: could not ask fabric for the latest loader, using $fid" >&2
    fi
  fi
  version="$fid"
fi
echo "version $version"
# each version keeps its jar (and natives) in its own dir; they all share the one instance dir
versiondir="$cachedir/versions/$version"
gamejson="$versiondir/$version.json"
mkdir -p "$versiondir" "$gamedir"
# fetchjson VER: make sure versions/VER/VER.json exists, downloading it from the manifest if not
fetchjson() {
  local v="$1" f="$cachedir/versions/$1/$1.json" u sha
  [ -f "$f" ] && return 0
  if $nodl; then echo "minecell: $v is not downloaded and no-download mode is on" >&2; return 1; fi
  mkdir -p "$(dirname "$f")"
  u="$(jq -er --arg v "$v" '.versions[] | select(.id == $v) | .url' "$manifest")" \
    || { echo "minecell: $v is not in the manifest and has no local json" >&2; return 1; }
  sha="$(jq -er --arg v "$v" '.versions[] | select(.id == $v) | .sha1' "$manifest")"
  curl -fsSL -o "$f.new" "$u" || { rm -f "$f.new"; echo "minecell: version json download failed" >&2; return 1; }
  if [ "$(sha1sum < "$f.new" | cut -d' ' -f1)" != "$sha" ]; then
    rm -f "$f.new"; echo "minecell: version json sha1 mismatch" >&2; return 1
  fi
  mv "$f.new" "$f"
}
fetchjson "$version" || exit 1
# a profile like fabric's only has what it changes and points at a vanilla version with inheritsFrom:
# merge the two (the profile wins, libraries and arguments are added together) and use the parent's jar
jarver="$version"
parent="$(jq -r '.inheritsFrom // empty' "$gamejson")"
if [ -n "$parent" ]; then
  case "$parent" in */*) echo "minecell: bad inheritsFrom: $parent" >&2; exit 1 ;; esac
  fetchjson "$parent" || exit 1
  jarver="$parent"
  merged="$tmpdir/merged.json"
  jq -s '.[0] as $p | .[1] as $c | ($p * $c) + {
      libraries: (($c.libraries // []) + ($p.libraries // [])),
      arguments: {jvm: (($p.arguments.jvm // []) + ($c.arguments.jvm // [])),
                  game: (($p.arguments.game // []) + ($c.arguments.game // []))}}' \
    "$cachedir/versions/$parent/$parent.json" "$gamejson" > "$merged" \
    || { echo "minecell: could not merge $version with $parent" >&2; exit 1; }
  gamejson="$merged"
fi
getj() { jq -er "$1" "$gamejson" || { echo "minecell: $gamejson has no $1" >&2; exit 1; }; }
mainclass="$(getj .mainClass)" || exit 1
versiontype="$(getj .type)" || exit 1
javamajor="$(getj .javaVersion.majorVersion)" || exit 1
clienturl="$(getj .downloads.client.url)" || exit 1
clientsha1="$(getj .downloads.client.sha1)" || exit 1
assetsid="$(getj .assetIndex.id)" || exit 1
assetsurl="$(getj .assetIndex.url)" || exit 1
assetssha1="$(getj .assetIndex.sha1)" || exit 1

# ---- which java to run ----
# -j / the config wins unless it is too old. otherwise: the system java if it is new enough for this version, else the one in
# <cache>/java/<major>, else download it (eclipse temurin jre from adoptium) unless no-download mode is on
javamajor_of() { "$1" -version 2>&1 | sed -n '1s/.*version "\([0-9]*\).*/\1/p'; }
getjava() {
  local arch os meta link sum dl top
  command -v tar > /dev/null || { echo "minecell: tar is needed to unpack java" >&2; return 1; }
  case "$(uname -m)" in
    x86_64|amd64) arch=x64 ;;
    aarch64|arm64) arch=aarch64 ;;
    *) echo "minecell: no automatic java download for $(uname -m), install java $javamajor yourself" >&2; return 1 ;;
  esac
  os=linux; if ldd --version 2>&1 | grep -qi musl; then os=alpine-linux; fi
  meta="$(curl -fsSL "https://api.adoptium.net/v3/assets/latest/$javamajor/hotspot?architecture=$arch&image_type=jre&os=$os&vendor=eclipse")" \
    || { echo "minecell: could not ask adoptium for java $javamajor" >&2; return 1; }
  link="$(jq -r '.[0].binary.package.link // empty' <<< "$meta")"
  sum="$(jq -r '.[0].binary.package.checksum // empty' <<< "$meta")"
  [ -n "$link" ] && [ -n "$sum" ] || { echo "minecell: adoptium has no java $javamajor jre for $os/$arch" >&2; return 1; }
  rm -rf "$cachedir"/java/.download.*
  dl="$cachedir/java/.download.$$"; mkdir -p "$dl"
  echo "minecell: no suitable java found, downloading java $javamajor (eclipse temurin jre, $(jq -r '.[0].binary.package.size / 1048576 | floor' <<< "$meta") MB)" >&2
  curl -fL# -o "$dl/jre.tar.gz" "$link" || { rm -rf "$dl"; echo "minecell: java download failed" >&2; return 1; }
  if [ "$(sha256sum < "$dl/jre.tar.gz" | cut -d' ' -f1)" != "$sum" ]; then
    rm -rf "$dl"; echo "minecell: java download has the wrong checksum" >&2; return 1
  fi
  tar -xzf "$dl/jre.tar.gz" -C "$dl" || { rm -rf "$dl"; echo "minecell: could not unpack java" >&2; return 1; }
  top="$(find "$dl" -mindepth 1 -maxdepth 1 -type d | head -1)"
  [ -x "$top/bin/java" ] || { rm -rf "$dl"; echo "minecell: the java download has no bin/java" >&2; return 1; }
  rm -rf "$cachedir/java/$javamajor"
  mv "$top" "$cachedir/java/$javamajor" && rm -rf "$dl"
}
skipsys=false
if [ "$java" != "java" ]; then
  # a java given with -j / the config that is too old (or not java at all) is replaced by minecell's own
  have="$(javamajor_of "$java" 2>/dev/null)"
  if [ -z "$have" ] || [ "$have" -lt "$javamajor" ]; then
    echo "minecell: $java is not java $javamajor or newer (found: ${have:-none}), using minecell's own java instead" >&2
    java="java"; skipsys=true
  fi
fi
if [ "$java" = "java" ]; then
  sysjava=""; $skipsys || { command -v java > /dev/null && sysjava="$(javamajor_of java)"; }
  if [ -n "$sysjava" ] && [ "$sysjava" -ge "$javamajor" ]; then
    : # the system java is new enough
  elif [ -x "$cachedir/java/$javamajor/bin/java" ]; then
    java="$cachedir/java/$javamajor/bin/java"
  elif $nodl; then
    # nothing to download: an old system java is reported by the version check at the end
    if [ -z "$sysjava" ] && ! $dryrun; then
      echo "minecell: no java found and no-download mode is on (install java $javamajor or run once without --no-download)" >&2
      exit 1
    fi
  else
    getjava || exit 1
    java="$cachedir/java/$javamajor/bin/java"
  fi
fi
# libraries that apply to linux, one per line: path<TAB>url<TAB>sha1
mapfile -t libs < <(jq -r '.libraries[]
  | select(((.rules // [{"action":"allow"}])
      | map(select((.os.name // "linux") == "linux") | .action) | last) == "allow")
  | (if .downloads.artifact then .downloads.artifact
     elif .name and .url then
       (.name | split(":")) as $n
       | ($n[0] | gsub("\\."; "/") + "/" + $n[1] + "/" + $n[2] + "/" + $n[1] + "-" + $n[2]
          + (if $n[3] then "-" + $n[3] else "" end) + ".jar") as $p
       | {path: $p, url: ((.url | if endswith("/") then . else . + "/" end) + $p), sha1: .sha1}
     else empty end) as $a
  | [$a.path, $a.url, ($a.sha1 // "")] | @tsv' "$gamejson")
# plain-string arguments only (the ones with rules come later); ${placeholders} still to be filled in
mapfile -t jvmargs < <(jq -r '.arguments.jvm[] | strings' "$gamejson")
mapfile -t gameargs < <(jq -r '.arguments.game[] | strings' "$gamejson")
# fetch URL FILE SHA1: download to FILE unless it is already there with the right sha1
fetch() {
  # no-download mode: a file is either there or it is not
  if $nodl; then [ -f "$2" ]; return; fi
  # an empty sha1 (maven-style libraries) means: present is good enough, and nothing to check after
  if [ -f "$2" ] && { [ -z "$3" ] || [ "$(sha1sum < "$2" | cut -d' ' -f1)" = "$3" ]; }; then return 0; fi
  mkdir -p "$(dirname "$2")"
  curl -fsSL -o "$2.new" "$1" || { rm -f "$2.new"; return 1; }
  if [ -n "$3" ] && [ "$(sha1sum < "$2.new" | cut -d' ' -f1)" != "$3" ]; then rm -f "$2.new"; return 1; fi
  mv "$2.new" "$2"
}
dlfail() {
  if $nodl; then echo "minecell: $1 is missing and no-download mode is on (run once without --no-download)" >&2
  else echo "minecell: $1 download failed" >&2; fi
}
clientjar="$cachedir/versions/$jarver/$jarver.jar"
fetch "$clienturl" "$clientjar" "$clientsha1" || { dlfail "the client jar"; exit 1; }
assetsdir="$cachedir/assets"
assetindex="$assetsdir/indexes/$assetsid.json"
fetch "$assetsurl" "$assetindex" "$assetssha1" || { dlfail "the asset index"; exit 1; }
# the objects are named after their own sha1, so only the missing ones are downloaded
missing="$tmpdir/missing"
jq -r '.objects[].hash' "$assetindex" | sort -u | while read -r h; do
  [ -f "$assetsdir/objects/${h:0:2}/$h" ] || echo "$h"
done > "$missing"
if $nodl && [ -s "$missing" ]; then
  echo "minecell: warning: $(wc -l < "$missing") assets are not downloaded (no-download mode), the game may lack some sounds or textures" >&2
  : > "$missing"
fi
if [ -s "$missing" ]; then
  total="$(wc -l < "$missing")"
  donefile="$tmpdir/done"; : > "$donefile"
  export assetsdir donefile
  # each finished asset appends one byte to $donefile, so its size is the count
  # job control gives xargs its own process group, so ctrl-c can kill it and its curls
  # (a plain background job ignores SIGINT and would keep downloading after the script died)
  set -m
  xargs -P 8 -n 1 bash -c '
    h="$1"; d="$assetsdir/objects/${h:0:2}"; mkdir -p "$d"
    t="$d/$h.new.$$"
    if curl -fsSL -o "$t" "https://resources.download.minecraft.net/${h:0:2}/$h" \
       && [ "$(sha1sum < "$t" | cut -d" " -f1)" = "$h" ]; then
      mv "$t" "$d/$h"; printf . >> "$donefile"
    else
      rm -f "$t"; echo "failed: $h" >&2; exit 1
    fi' _ < "$missing" &
  xpid=$!
  trap 'kill -- -"$xpid" 2>/dev/null; echo; exit 130' INT TERM
  while kill -0 "$xpid" 2>/dev/null; do
    printf '\r%d/%d assets done' "$(wc -c < "$donefile")" "$total"
    sleep 0.2
  done
  wait "$xpid"; xstatus=$?
  trap - INT TERM
  set +m
  [ "$xstatus" -eq 0 ] || { echo; echo "minecell: some assets failed to download" >&2; exit 1; }
  printf '\r%d/%d assets done\n' "$(wc -c < "$donefile")" "$total"
fi
# libraries (the client jar's dependencies): one quiet curl each, with a counter instead of 66 meters
libsdir="$cachedir/libraries"
# only touch the libraries if at least one file is missing
needlibs=false
for line in "${libs[@]}"; do
  IFS=$'\t' read -r lpath _ <<< "$line"
  [ -f "$libsdir/$lpath" ] || { needlibs=true; break; }
done
if $needlibs && $nodl; then
  echo "minecell: some libraries are not downloaded and no-download mode is on (run once without --no-download)" >&2
  exit 1
fi
if $needlibs; then
  nlibs="${#libs[@]}"; n=0
  for line in "${libs[@]}"; do
    IFS=$'\t' read -r lpath lurl lsha1 <<< "$line"
    fetch "$lurl" "$libsdir/$lpath" "$lsha1" || { echo; echo "minecell: library download failed: $lpath" >&2; exit 1; }
    n=$((n+1))
    printf '\r%d/%d libraries done' "$n" "$nlibs"
  done
  echo
fi
# worlds live outside the instance; link them in
mkdir -p "$worlds"
if [ -L "$gamedir/saves" ] || ! [ -e "$gamedir/saves" ]; then
  ln -sfn "$worlds" "$gamedir/saves"
else
  # a real saves dir: move its worlds into $worlds (never overwriting), then link
  find "$gamedir/saves" -mindepth 1 -maxdepth 1 -exec mv -n -t "$worlds" -- {} +
  if rmdir "$gamedir/saves" 2>/dev/null; then
    ln -sfn "$worlds" "$gamedir/saves"
  else
    echo "minecell: some worlds in $gamedir/saves clash with ones in $worlds, left saves alone" >&2
  fi
fi

# ---- launch ----
cp=""
for line in "${libs[@]}"; do
  IFS=$'\t' read -r lpath _ <<< "$line"
  cp+="$libsdir/$lpath:"
done
cp+="$clientjar"
# ---- microsoft login (-o): device code -> xbox live -> xsts -> minecraft ----
# the client id is the official launcher's (the same one viaproxy's login uses); set ms_client_id in the
# config to use your own azure app registration instead
[ -n "$msclient" ] || msclient="00000000402b5328"
authfile="$cachedir/auth.json"
mspost() { curl -sS -H 'Content-Type: application/json' -H 'Accept: application/json' -d "$2" "$1"; }
msfail() { echo "minecell: $*" >&2; return 1; }
msauth() {
  local now rt resp ms_access="" ms_refresh="" dev user_code uri interval expires end err
  local xbl xblhash xsts xstshash xerr prof raw mcexp
  now=$(date +%s)
  # a minecraft token that is still valid is used as is
  if [ -f "$authfile" ] && jq -e --argjson now "$now" '(.mc_expires // 0) > ($now + 120)' "$authfile" > /dev/null 2>&1; then
    mcname=$(jq -r .name "$authfile"); mcuuid=$(jq -r .uuid "$authfile"); mctoken=$(jq -r .mc_token "$authfile")
    return 0
  fi
  if $nodl; then msfail "no-download mode: there is no valid saved login, and logging in needs the internet"; return 1; fi
  rt=""; [ -f "$authfile" ] && rt=$(jq -r '.refresh_token // empty' "$authfile")
  if [ -n "$rt" ]; then
    resp=$(curl -sS -d "client_id=$msclient" -d "grant_type=refresh_token" --data-urlencode "refresh_token=$rt" \
           -d "scope=service::user.auth.xboxlive.com::MBI_SSL" https://login.live.com/oauth20_token.srf)
    ms_access=$(jq -r '.access_token // empty' <<< "$resp")
    ms_refresh=$(jq -r '.refresh_token // empty' <<< "$resp")
  fi
  if [ -z "$ms_access" ]; then
    resp=$(curl -sS -d "client_id=$msclient" -d "scope=service::user.auth.xboxlive.com::MBI_SSL" \
           -d "response_type=device_code" https://login.live.com/oauth20_connect.srf)
    user_code=$(jq -r '.user_code // empty' <<< "$resp")
    [ -n "$user_code" ] || { msfail "could not start the microsoft login: $(jq -r '.error_description // .error // "no answer"' <<< "$resp")"; return 1; }
    dev=$(jq -r .device_code <<< "$resp"); uri=$(jq -r '.verification_uri // "https://www.microsoft.com/link"' <<< "$resp")
    interval=$(jq -r '.interval // 5' <<< "$resp"); expires=$(jq -r '.expires_in // 900' <<< "$resp")
    echo "minecell: to log in, open $uri and enter the code $user_code" >&2
    printf "          alternatively, open $uri?otc=$user_code"
    if command -v xdg-open >/dev/null 2>&1; then
      trap "echo;xdg-open $uri?otc=$user_code" TSTP
      printf " or press ctrl+z to open in your web browser."
    fi
    echo
    end=$(( $(date +%s) + expires ))
    while [ "$(date +%s)" -lt "$end" ]; do
      sleep "$interval"
      resp=$(curl -sS -d "client_id=$msclient" -d "grant_type=urn:ietf:params:oauth:grant-type:device_code" \
             --data-urlencode "device_code=$dev" https://login.live.com/oauth20_token.srf)
      ms_access=$(jq -r '.access_token // empty' <<< "$resp")
      if [ -n "$ms_access" ]; then
        ms_refresh=$(jq -r '.refresh_token // empty' <<< "$resp")
        break; fi
      err=$(jq -r '.error // empty' <<< "$resp")
      case "$err" in authorization_pending|slow_down|"") ;; *) msfail "microsoft login failed: $err";trap - TSTP return 1 ;; esac
    done
    trap - TSTP
    [ -n "$ms_access" ] || { msfail "the login code expired, run it again"; return 1; }
  fi
  resp=$(mspost https://user.auth.xboxlive.com/user/authenticate "$(jq -n --arg t "$ms_access" \
         '{Properties:{AuthMethod:"RPS",SiteName:"user.auth.xboxlive.com",RpsTicket:("t=" + $t)},RelyingParty:"http://auth.xboxlive.com",TokenType:"JWT"}')")
  xbl=$(jq -r '.Token // empty' <<< "$resp")
  [ -n "$xbl" ] || { msfail "xbox live login failed"; return 1; }
  resp=$(mspost https://xsts.auth.xboxlive.com/xsts/authorize "$(jq -n --arg t "$xbl" \
         '{Properties:{SandboxId:"RETAIL",UserTokens:[$t]},RelyingParty:"rp://api.minecraftservices.com/",TokenType:"JWT"}')")
  xsts=$(jq -r '.Token // empty' <<< "$resp"); xstshash=$(jq -r '.DisplayClaims.xui[0].uhs // empty' <<< "$resp")
  if [ -z "$xsts" ]; then
    xerr=$(jq -r '.XErr // empty' <<< "$resp")
    case "$xerr" in
      2148916233) msfail "this microsoft account has no xbox profile yet: sign in once at minecraft.net to create it" ;;
      2148916235) msfail "xbox live is not available in this account's country" ;;
      2148916238) msfail "this is a child account: an adult has to add it to a microsoft family first" ;;
      *) msfail "xsts login failed${xerr:+ (error $xerr)}" ;;
    esac
    return 1
  fi
  resp=$(mspost https://api.minecraftservices.com/authentication/login_with_xbox "$(jq -n --arg h "$xstshash" --arg t "$xsts" \
         '{identityToken:("XBL3.0 x=" + $h + ";" + $t)}')")
  mctoken=$(jq -r '.access_token // empty' <<< "$resp"); mcexp=$(jq -r '.expires_in // 86400' <<< "$resp")
  [ -n "$mctoken" ] || { msfail "minecraft login failed: $(jq -r '.errorMessage // .error // "no answer"' <<< "$resp")"; return 1; }
  prof=$(curl -sS -H "Authorization: Bearer $mctoken" https://api.minecraftservices.com/minecraft/profile)
  mcname=$(jq -r '.name // empty' <<< "$prof"); raw=$(jq -r '.id // empty' <<< "$prof")
  [ -n "$mcname" ] && [ -n "$raw" ] || { msfail "this account has no minecraft java profile (does it own the game?)"; return 1; }
  mcuuid="${raw:0:8}-${raw:8:4}-${raw:12:4}-${raw:16:4}-${raw:20:12}"
  # keep the refresh token and the minecraft token for next time, readable by this user only
  ( umask 077
    jq -n --arg rt "${ms_refresh:-$rt}" --arg tok "$mctoken" --arg name "$mcname" --arg uuid "$mcuuid" --argjson exp $(( $(date +%s) + mcexp )) \
      '{refresh_token:$rt, mc_token:$tok, mc_expires:$exp, name:$name, uuid:$uuid}' > "$authfile.new" ) && mv "$authfile.new" "$authfile" && chmod 600 "$authfile"
}
# offline uuid: md5 of "OfflinePlayer:<name>" with the version (3) and variant bits forced
offline_uuid() {
  h=$(printf 'OfflinePlayer:%s' "$name" | md5sum | cut -c1-32)
  h="${h:0:12}3${h:13:3}$(printf %x $(( (0x${h:16:1} & 3) | 8 )))${h:17:15}"
  uuid="${h:0:8}-${h:8:4}-${h:12:4}-${h:16:4}-${h:20:12}"
}
if $online && ! $dryrun; then
  msauth || exit 1
  name="$mcname"; uuid="$mcuuid"; usertype="msa"
elif $online; then
  uuid="00000000-0000-0000-0000-000000000000"; mctoken="<access token>"; usertype="msa"
  echo "minecell: --dry-run does not log in, so the real name, uuid and token are not shown" >&2
elif [ -n "$skinof" ]; then
  # use a real account's uuid so the client fetches its skin from mojang's session server
  [[ "$skinof" =~ ^[A-Za-z0-9_]{1,16}$ ]] || { echo "minecell: $skinof is not a valid minecraft name" >&2; exit 1; }
  skincache="$cachedir/skin-$skinof"
  if $nodl; then
    raw="$(cat "$skincache" 2>/dev/null)"
    [ -n "$raw" ] || echo "minecell: warning: no-download mode and no saved uuid for $skinof, using the offline uuid" >&2
  else
    raw="$(curl -fsL "https://api.mojang.com/users/profiles/minecraft/$skinof" | jq -er .id)" \
      || { echo "minecell: could not find a minecraft account named $skinof" >&2; exit 1; }
    printf '%s\n' "$raw" > "$skincache"
  fi
  if [ -n "$raw" ]; then
    uuid="${raw:0:8}-${raw:8:4}-${raw:12:4}-${raw:16:4}-${raw:20:12}"
  else
    offline_uuid
  fi
else
  offline_uuid
fi
mkdir -p "$versiondir/natives"
declare -A ph=(
  [auth_player_name]="$name" [auth_uuid]="$uuid" [auth_access_token]="${mctoken:-0}"
  [auth_xuid]="" [clientid]="" [user_type]="$usertype"
  [version_name]="$version" [version_type]="$versiontype"
  [game_directory]="$gamedir" [assets_root]="$assetsdir" [assets_index_name]="$assetsid"
  [natives_directory]="$versiondir/natives" [launcher_name]="minecell" [launcher_version]="$VERSION"
  [classpath]="$cp"
)
subst() {
  local a="$1" k
  for k in "${!ph[@]}"; do a="${a//"\${$k}"/"${ph[$k]}"}"; done
  printf '%s' "$a"
}
joinaddr="$server"
if $fakeonline; then
  # a random free local port for viaproxy, between 35565 and 45565
  while :; do
    port=$((35565 + RANDOM % 10001))
    (exec 9<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || break
  done
  joinaddr="127.0.0.1:$port"
fi
cmd=("$java")
[ -n "$mem" ] && cmd+=("-Xmx$mem")
for a in "${jvmargs[@]}"; do cmd+=("$(subst "$a")"); done
cmd+=("$mainclass")
for a in "${gameargs[@]}"; do cmd+=("$(subst "$a")"); done
if [ -n "$server" ]; then cmd+=(--quickPlayMultiplayer "$joinaddr"); fi
cmd+=("${extra[@]}")
{
  echo "minecell: config"
  printf '  %-9s %s\n' "player" "$name ($uuid)$($online && echo ' [microsoft login]')"
  if [ -n "$skinof" ]; then printf '  %-9s %s\n' "skin of" "$skinof"; fi
  printf '  %-9s %s\n' "version" "$version ($versiontype)"
  printf '  %-9s %s\n' "instance" "$gamedir"
  printf '  %-9s %s\n' "java" "$java (this version needs $javamajor or newer)"
  printf '  %-9s %s\n' "memory" "${mem:-default}"
  if $fakeonline; then
    printf '  %-9s %s\n' "server" "$server (fake online mode, through viaproxy on $joinaddr)"
  else
    printf '  %-9s %s\n' "server" "${server:-none}"
  fi
} >&2
showcmd() {
  local a
  for a in "${cmd[@]}"; do
    if [ -n "$mctoken" ] && [ "$a" = "$mctoken" ] && [ "$mctoken" != "<access token>" ]; then printf '%s ' '<hidden>'; else printf '%q ' "$a"; fi
  done
  echo
}
if $dryrun; then
  {
    if $fakeonline; then
      printf 'cd %q && %q -jar via.jar config viaproxy.yml &\n' "$viaproxydir" "$java"
    fi
    printf 'cd %q && ' "$gamedir"
    showcmd
  } >&3
  if $fakeonline; then
    echo "minecell: a real run would set bind-address 127.0.0.1:$port and target-address $server in $viaproxydir/viaproxy.yml" >&2
  fi
  exit 0
fi
{
  echo "minecell: running:"
  if $fakeonline; then
    printf 'cd %q && %q -jar via.jar config viaproxy.yml &\n' "$viaproxydir" "$java"
  fi
  printf 'cd %q && ' "$gamedir"
  showcmd
} >&2
# the java must be at least what this version asks for
have="$("$java" -version 2>&1 | sed -n '1s/.*version "\([0-9]*\).*/\1/p')"
if [ -z "$have" ] || [ "$have" -lt "$javamajor" ]; then
  echo "minecell: this version needs java $javamajor or newer (found: ${have:-none})" >&2
  exit 1
fi
if $fakeonline; then
  yml="$viaproxydir/viaproxy.yml"
  # point viaproxy at the target server, on the random local port, logging in with its saved account
  sed -i -e "s|^bind-address:.*|bind-address: 127.0.0.1:$port|" \
         -e "s|^target-address:.*|target-address: $server|" \
         -e "s|^auth-method:.*|auth-method: ACCOUNT|" "$yml"
  if ! grep -q "^bind-address: 127.0.0.1:$port\$" "$yml" || ! grep -q "^target-address: $server\$" "$yml"; then
    echo "minecell: could not edit $yml (bind-address or target-address line missing)" >&2
    exit 1
  fi
  if ! jq -e '(.accountsV4 // []) | length > 0' "$viaproxydir/saves.json" > /dev/null 2>&1; then
    echo "minecell: warning: viaproxy has no saved account, run minecell --proxy-login and add one" >&2
  fi
  mkdir -p "$viaproxydir/logs"
