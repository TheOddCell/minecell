def die(msg):
    print("minecellweb: " + msg, file=sys.stderr)
    sys.exit(1)


def say(msg):
    print("minecellweb: " + msg, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- finding minecell

def find_minecell(explicit, tmpdir):
    if explicit:
        if not (os.path.isfile(explicit) and os.access(explicit, os.X_OK)):
            die(f"{explicit} is not an executable file")
        return os.path.abspath(explicit), "given with --minecell"
    cur = os.path.join(os.getcwd(), "minecell")
    if os.path.isfile(cur) and os.access(cur, os.X_OK):
        return cur, "the current directory"
    found = shutil.which("minecell")
    if found:
        return found, "PATH"
    say("minecell not found in the current directory or PATH, downloading " + MINECELL_URL)
    try:
        # the server turns away python's default user agent
        req = urllib.request.Request(MINECELL_URL, headers={"User-Agent": "minecellweb/" + VERSION})
        with urllib.request.urlopen(req, timeout=30) as r:
            data = r.read(2_000_000)
    except Exception as e:
        die(f"could not download minecell: {e}")
    if not data.startswith(b"#!"):
        die("what was downloaded does not look like a script, not using it")
    dest = os.path.join(tmpdir, "minecell")
    with open(dest, "wb") as f:
        f.write(data)
    os.chmod(dest, 0o755)
    return dest, "downloaded"


# ---------------------------------------------------------------- running the game

class Busy(Exception):
    pass


class Game:
    """one minecell process at a time, with its output kept for the page"""

    LOGIN_RE = re.compile(r"open (https?://\S+) and enter the code (\S+)")
    DIRECT_RE = re.compile(r"visit (https?://[^\s,]+)")

    def __init__(self, mc):
        self.mc = mc
        self.lock = threading.Lock()
        self.proc = None
        self.lines = collections.deque(maxlen=4000)
        self.total = 0
        self.login = None
        self.rc = None
        self.mode = None
        self.has_verbose = True    # whether this minecell knows -V (older ones show the game log anyway)

    def add(self, line):
        if len(line) > 400:
            line = f"{line[:400]} ... ({len(line)} characters)"
        with self.lock:
            self.lines.append(line)
            self.total += 1
            m = self.LOGIN_RE.search(line)
            if m:
                self.login = {"uri": m.group(1), "code": m.group(2), "direct": None}
            m = self.DIRECT_RE.search(line)
            if m and self.login:
                self.login["direct"] = m.group(1)
            if line.startswith("minecell: config"):
                self.login = None

    def running(self):
        p = self.proc
        return p is not None and p.poll() is None

    def start(self, args, env, mode):
        if self.running():
            raise Busy()
        self.add("--- minecellweb: minecell " + " ".join(args))
        self.rc = None
        self.mode = mode
        self.login = None
        proc = subprocess.Popen([self.mc] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, env=env, start_new_session=True,
                                text=True, errors="replace", bufsize=1)
        self.proc = proc
        threading.Thread(target=self._read, args=(proc,), daemon=True).start()

    def _read(self, proc):
        for line in proc.stdout:
            self.add(line.rstrip("\n"))
        proc.wait()
        self.rc = proc.returncode
        with self.lock:
            self.login = None
        self.add(f"--- exited with code {proc.returncode}")

    def stop(self):
        """ask the game to quit and, if it hangs, kill it (before this returns: the caller may be about to exit)"""
        p = self.proc
        if p is None or p.poll() is not None:
            return
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        try:
            p.wait(5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            p.wait()

    def state(self, since):
        with self.lock:
            total = self.total
            first = total - len(self.lines)
            start = max(since, first)
            lines = list(self.lines)[start - first:]
            return {"running": self.running(), "mode": self.mode, "rc": self.rc, "login": self.login,
                    "lines": lines, "next": total}


def build_args(o, fullscreen=None, verbose=True, login_only=False):
    a = ["-V"] if verbose else []
    ver = o["version"]
    if ver == "latest-snapshot":
        a.append("-s")
    elif ver != "latest":
        a += ["-v", ver]
    if o["fabric"]:
        a.append("-f")
    if login_only:
        a.append("--login-only")      # log in (the code shows on the page) and stop, the game starts afterwards
    elif o["online"]:
        a.append("-o")
    if fullscreen:
        w, h = fullscreen
        a += ["--", "--fullscreen", "--width", str(w), "--height", str(h)]
    return a


def parse_options(d):
    """validate what the page sent; returns (options, error)"""
    if not isinstance(d, dict):
        return None, "bad request"
    ver = str(d.get("version") or "latest")
    if ver not in ("latest", "latest-snapshot") and not VERSION_RE.match(ver):
        return None, "bad version"
    return {"version": ver, "fabric": bool(d.get("fabric")), "online": bool(d.get("online"))}, None


_vcache = {"t": 0, "data": None}


def list_versions(game, refresh):
    if not refresh and _vcache["data"] is not None and time.time() - _vcache["t"] < 120:
        return _vcache["data"], None
    try:
        r = subprocess.run([game.mc, "-l", "-s"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           errors="replace", timeout=90)
    except Exception as e:
        return None, f"could not run minecell: {e}"
    if r.returncode != 0:
        return None, "minecell -l failed: " + (r.stderr.strip().splitlines() or ["no message"])[-1]
    out = []
    for line in r.stdout.splitlines():
        parts = line.split()
        if parts:
            out.append({"id": parts[0], "type": parts[1] if len(parts) > 1 else "release"})
    _vcache["t"] = time.time()
    _vcache["data"] = out
    return out, None


